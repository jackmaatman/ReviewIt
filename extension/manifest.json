{
  "manifest_version": 3,
  "name": "Box Review Sync",
  "version": "0.1.0",
  "description": "Small host-authoritative sync for internal Box video reviews.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.box.com/*", "https://box.com/*", "https://drive.google.com/*", "https://*.googleapis.com/*", "https://*.googleusercontent.com/*", "https://reviewit-zoba.onrender.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Box Review Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.box.com/*", "https://box.com/*", "https://drive.google.com/*"],
      "js": ["providers.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://drive.google.com/*", "https://*.googleapis.com/*", "https://*.googleusercontent.com/*"],
      "js": ["drive-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://reviewit-zoba.onrender.com/join*"],
      "js": ["join.js"],
      "run_at": "document_idle"
    }
  ]
}